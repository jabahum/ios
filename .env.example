# -----------------------------
# core
# -----------------------------
APP_ENV=local # local | dev | staging | prod

# -----------------------------
# Database
# -----------------------------
DB_USER=postgres
DB_PASSWORD=pwaiswa
DB_NAME=ios
DB_HOST=db

# IMPORTANT:
# - When running in Docker: DB_HOST=db, DB_PORT=5432
# - When running locally: DB_HOST=localhost, DB_PORT=5433 (or 5432)
DB_HOST=db
DB_PORT=5432

# -----------------------------
# External API
# -----------------------------
AT_API_KEY=atsk_61b9c1263274354777a72f520c72f965d0eb34a6f95e79c81e11477066a7ca05733aa31e
AT_USERNAME=hbc_user
AT_PHONE=+256323200977

# -----------------------------
# Authentication
# -----------------------------
AUTH_PROVIDER=true

# --------------------------------------------------
# Keycloak (OIDC) – URL separation (IMPORTANT)
# --------------------------------------------------

# Used by backend containers (token, userinfo, admin APIs)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Used by browser (login UI, redirects)
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Backward compatibility (DEPRECATED – remove later)
KEYCLOAK_BASEURL=http://keycloak:8080

# --------------------------------------------------
# Keycloak core settings
# --------------------------------------------------

KEYCLOAK_REALM=moh-realm
KEYCLOAK_CLIENT_ID=integrated-outbreak-system
KEYCLOAK_CLIENT_SECRET=ios-secret
KEYCLOAK_AUDIENCE=integrated-outbreak-system

# OAuth redirect (browser-visible)
KEYCLOAK_REDIRECT_URI=http://localhost:3001/auth/callback

# -----------------------------
# Cookies
# -----------------------------
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false

# -----------------------------
# UI redirects
# -----------------------------
AUTH_SUCCESS_REDIRECT=/home
AUTH_LOGOUT_REDIRECT=/login

# -----------------------------
# Token cookies
# -----------------------------
AUTH_ACCESS_TOKEN_NAME=access_token
AUTH_REFRESH_TOKEN_NAME=refresh_token

# -----------------------------
# Session
# -----------------------------
AUTH_SESSION_MAX_AGE=86400

# -----------------------------
# Keycloak Admin (future / service account)
# -----------------------------
KEYCLOAK_ADMIN_CLIENT_ID=integrated-outbreak-system-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=ios-admin-secret
