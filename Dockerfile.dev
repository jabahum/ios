# syntax=docker/dockerfile:1

FROM golang:1.24

WORKDIR /var/www/integrated-outbreak-system/app

# Install dev hot-reload tool
RUN go install github.com/air-verse/air@v1.61.7

# Copy dependency files first for better Docker cache usage
COPY go.mod go.sum ./
RUN go mod download

# Copy app source
COPY . .

# Keep module files clean and ensure dependencies are resolved
RUN go mod tidy

# App port
EXPOSE 8080

# Hot reload for development
CMD ["air"]